# ========================================================
# VocalGuard Environment Configuration (Template)
# Copy this file to .env and configure your URLs
# ========================================================

# Frontend: URL of your FastAPI backend service
VITE_API_BASE_URL=http://localhost:8000

# Backend: Allowed frontend URLs for CORS (comma-separated or *)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,*

# Backend Host & Port
HOST=0.0.0.0
PORT=8000

# Path to model weights file
MODEL_PATH=model/voice_deepfake_detector.pth
