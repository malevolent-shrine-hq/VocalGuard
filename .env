# ========================================================
# VocalGuard Environment Configuration
# ========================================================

# 1. FRONTEND CONFIGURATION
# Set this to your backend server URL.
# - Local development: http://localhost:8000
# - Remote hosted backend: https://your-backend-api.onrender.com (or your Vercel/Railway URL)
# Note: In Vite, environment variables exposed to the client must begin with VITE_
VITE_API_BASE_URL=http://localhost:8000

# 2. BACKEND CONFIGURATION
# Allowed frontend origins for CORS in FastAPI.
# Comma-separated URLs or '*' to allow all origins.
# Example for production: https://vocalguard.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,*

# Backend Server Host and Port
HOST=0.0.0.0
PORT=8000

# Path to trained deepfake detector PyTorch model
MODEL_PATH=model/voice_deepfake_detector.pth
